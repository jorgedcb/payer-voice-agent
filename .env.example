# Configure this worker separately; never copy another checkout's configuration.
# The name this worker registers under; the backend dispatches calls to it.
VOICE_CALL_AGENT_NAME=voice-agent
# OTel service.name on every trace.
TRACING_SERVICE_NAME=voice-agent
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_TRUNK_ID=
# Where the session report and the call audio land. Match the backend's buckets.
SESSION_REPORT_BUCKET=
AUDIO_RECORDING_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional. Tracing only enables against the HIPAA Langfuse region; a BAA must be in force.
LANGFUSE_BASE_URL=https://hipaa.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Required: the primary voice runs on your own ElevenLabs account.
ELEVEN_API_KEY=
